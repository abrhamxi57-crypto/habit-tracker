# ==========================================
# HabitFlow Production Environment Variables
# ==========================================

# Environment mode ('development' or 'production')
ENVIRONMENT=production

# Reverse Proxy Port Exposure
PORT=80

# PostgreSQL Configuration
POSTGRES_DB=habitflow
POSTGRES_USER=habitflow
POSTGRES_PASSWORD=replace_with_strong_database_password_32chars

# Application Secret Key for JWT Signing (Generate via: openssl rand -hex 32)
SECRET_KEY=replace_with_hex_encoded_32_byte_secret_key_in_production

# JWT Lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Security & Rate Limiting (Requests per minute per IP for auth endpoints)
RATE_LIMIT_SENSITIVE_PER_MINUTE=30

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,https://yourdomain.com
